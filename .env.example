NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:3001

# DEV-ONLY — delete once canvas-dashboard/session-lifecycle land. A canvas
# row + session row you created by hand in Supabase; node writes hang off
# these until the app can create/load real ones.
NEXT_PUBLIC_DEV_CANVAS_ID=
NEXT_PUBLIC_DEV_SESSION_ID=

# Set to "true" to fall back to the local-only mock persistence (no Supabase
# writes) instead of the real path.
NEXT_PUBLIC_USE_MOCK_PERSISTENCE=
